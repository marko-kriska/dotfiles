# Basic movement
def_key "j"
    scroll_down
def_key "k"
    scroll_up
def_key "h"
    previous_column
def_key "l"
    next_column

# Jump to start/end of the list
def_key "g"
    move_home
def_key "G"
    move_end

# Page up/down (Ctrl+u / Ctrl+d, like in vim)
def_key "ctrl-u"
    page_up
def_key "ctrl-d"
    page_down

# Search
def_key "/"
    find
def_key "n"
    next_found_item
def_key "N"
    previous_found_item

# Move items within the playlist (J/K instead of shift+arrow)
def_key "J"
    move_sort_order_down
def_key "K"
    move_sort_order_up

# Delete (single key to delete an item)
def_key "d"
    delete_playlist_items
